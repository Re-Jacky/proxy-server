# Proxy Server Configuration

# Port for the proxy server to listen on
# Default: 8080
PORT=8888

# Authentication settings
# Enable or disable authentication
# Default: true
AUTH_ENABLED=false

# Authentication credentials
# REQUIRED when AUTH_ENABLED=true
# Username must be at least 3 characters
# Password must be at least 8 characters for security
PROXY_USERNAME=admin
PROXY_PASSWORD=your-secure-password-here

# Logging settings
# Log file name (stored in logs/ directory)
# Default: proxy.log
LOG_FILE=proxy.log

# Log verbosity level
# Options: error, warn, info, debug
# Default: info
LOG_LEVEL=info

# Timeout settings (milliseconds)
# HTTP request timeout
# Default: 60000 (60 seconds)
REQUEST_TIMEOUT=60000

# Socket connection timeout
# Default: 60000 (60 seconds)
CONNECTION_TIMEOUT=60000

# Maximum concurrent connections
# Default: 1000
MAX_CONNECTIONS=1000

# Admin dashboard credentials (required)
# Username must be at least 3 characters
# Password must be at least 8 characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123